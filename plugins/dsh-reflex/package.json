{
  "name": "@deepseek-reflex/dsh-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Use the independent Reflex website window without adding side questions to your DSH session.",
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "launcher.js", "client.js", "cordis.patch.yml", "locale", "icon.svg", "README.md", "VERIFICATION.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"] },
    "engines": { "dsh": ">=0.1.5-rc.2 <0.3.0" }
  },
  "scripts": { "build": "node scripts/build.mjs", "test": "node --test tests/*.test.mjs", "check": "node --check index.js && node --check launcher.js && node --check client.js && node scripts/build.mjs --check", "preview": "node tests/browser.mjs" },
  "devDependencies": { "esbuild": "0.25.12", "react": "18.3.1", "react-dom": "18.3.1" }
}
